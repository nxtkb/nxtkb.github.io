---
import ProductLayout from '../layouts/ProductLayout.astro';
import ProductVisual from './ProductVisual.astro';
import SweepProConfigurator from './SweepProConfigurator.astro';
import { sweepProConfiguration } from '../utils/sweep-pro-config.mjs';
import { externalLinkAttrs } from '../utils/external-links.mjs';
interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const base = isZh ? '/zh' : '';
const assets = '/products/ferris-sweep-pro';
const initialHardwarePrice = sweepProConfiguration(true, true)!.price;
const t = isZh ? {
  description: 'Ferris Sweep Pro，34 键无线分体键盘。双旋钮、ZMK Studio 实时改键，可选电子墨水屏与 Cirque 触控板。',
  headline: '少一些按键\n多一些自如',
  intro: '34 键无线分体设计，让双手找到自己的位置。双旋钮、可选触控板与电子墨水屏，将日常操作收拢到指尖。',
  price: '¥620 起', buy: '选择你的 Sweep Pro', docs: '使用文档',
  facts: [['34 键', '分体式矮轴布局'], ['双旋钮', '旋转与按压控制'], ['蓝牙 + USB-C', '无线或有线连接'], ['4000mAh', '左右合计电池容量']],
  featureTitle: '输入之外，也很顺手。', featureLead: '光标控制与状态显示，按你的工作习惯选择。',
  trackpad: ['Cirque 触控板 · 可选', '光标，近在手边。', '40mm 圆形触控板支持移动、点击、双击、右键与边缘滚动。从输入到操作，少一次伸手。'],
  display: ['电子墨水屏 · 可选', '当前状态，一眼明了。', '电量、连接和当前层级，直接在键盘上查看。1.54 英寸低功耗电子墨水屏，在明亮环境下也清晰可读。'],
  keymapTitle: '34 键，\n打开更多可能。',
  keymapCopy: '将字母留在主层，把数字、符号、导航与功能键放入不同层级。熟悉之后，常用输入就在手指附近。',
  keymapNote: '分层布局需要适应时间。购买前，可以先查看默认键位，了解它是否符合你的输入习惯。',
  keymapLink: '探索默认键位',
  studioTitle: '让键位，跟上你的习惯。', studioCopy: '通过 ZMK Studio 调整日常键位并直接保存，无需每次重新编译固件。配合带副层级侧刻的 PBT 矮轴键帽，从记住键位到形成自己的布局。', studioLink: '了解实时改键',
  colorTitle: '为桌面，添一点个性。', colorLead: '从简洁黑白到鲜明配色，找到你的搭配。',
  faqTitle: '你可能还想了解。',
  faqs: [
    ['第一次使用 34 键键盘，需要适应吗？', '需要。数字、符号和功能键通过层级访问，与传统键盘不同。建议先阅读默认键位文档，再逐步调整为适合自己的布局。'],
    ['电子墨水屏和触控板可以分别选择吗？', '可以。两项模块可独立选配，也可以同时选择或都不选，按你的使用习惯搭配。'],
    ['改键需要自己编译固件吗？', '日常键位调整可通过 ZMK Studio 实时修改并保存。涉及固件配置的更改，再按照文档重新构建和刷写。'],
    ['可以搭配磁吸支架吗？', '可以选择键盘与磁吸支架套餐。具体套餐内容与配色、轴体选项，请查看所选配置的商品页。'],
  ],
  supportTitle: '从第一次连接，到顺手使用。', supportLead: '使用文档、开源固件和选购咨询，随时可查。',
  resources: [['使用指南', '连接、层级、改键和固件更新。', '阅读文档', `${base}/docs/setup/ferris-sweep-pro/`], ['开源固件', '了解键盘配置，探索自己的布局。', '前往 GitHub', 'https://github.com/nxtkb/Sweep-Pro']],
  contactTitle: '选购与使用咨询', contactCopy: '微信：nxtkb888 · Discord：@lilin0522',
} : {
  description: 'Ferris Sweep Pro: a 34-key wireless split keyboard with dual encoders, ZMK Studio, and optional e-ink display and Cirque trackpad.',
  headline: 'Fewer keys\nMore possibilities',
  intro: 'A 34-key wireless split design that gives each hand its own space. Dual encoders, an optional trackpad, and e-ink status keep everyday controls close.',
  price: 'From ¥620', buy: 'Choose your Sweep Pro', docs: 'Read the docs',
  facts: [['34 keys', 'Low-profile split layout'], ['Dual encoders', 'Turn and press to control'], ['Bluetooth + USB-C', 'Wireless or wired'], ['4000mAh', 'Combined battery capacity']],
  featureTitle: 'Go beyond typing.', featureLead: 'Choose pointer control and status display to suit the way you work.',
  trackpad: ['Cirque trackpad · Optional', 'Keep your cursor close.', 'The 40mm circular trackpad supports movement, clicks, double clicks, right click, and edge scrolling. One less reach between typing and doing.'],
  display: ['E-ink display · Optional', 'Your status, at a glance.', 'Check battery, connection, and the active layer right on your keyboard. The 1.54-inch low-power e-ink display stays readable in bright surroundings.'],
  keymapTitle: '34 keys.\nRoom to do more.',
  keymapCopy: 'Keep letters on the base layer and reach numbers, symbols, navigation, and functions through layers. Once familiar, everyday inputs stay close to your fingers.',
  keymapNote: 'Layers take time to learn. Explore the default keymap before buying to see how it fits your workflow.', keymapLink: 'Explore the default keymap',
  studioTitle: 'Make the layout your own.', studioCopy: 'Edit everyday key assignments in ZMK Studio and save them directly, without rebuilding firmware each time. PBT low-profile keycaps with side legends help you learn your layers along the way.', studioLink: 'Learn about live editing',
  colorTitle: 'A little more you.', colorLead: 'Find your pairing, from understated black and white to expressive color.',
  faqTitle: 'A few things to know.',
  faqs: [
    ['Is there a learning curve with 34 keys?', 'Yes. Numbers, symbols, and functions are accessed through layers. Start by exploring the default keymap, then adapt it to your own workflow.'],
    ['Can I choose the display and trackpad separately?', 'Yes. Choose either module, both, or neither to suit your workflow.'],
    ['Do I need to compile firmware to change keys?', 'Everyday key assignments can be edited and saved live in ZMK Studio. Firmware configuration changes may still require building and flashing, as explained in the docs.'],
    ['Can I add magnetic stands?', 'Keyboard and magnetic-stand bundles are available. Check the matching product listing for bundle contents, colors, and switch choices.'],
  ],
  supportTitle: 'From first connection to daily flow.', supportLead: 'Guides, open-source firmware, and help choosing your setup.',
  resources: [['Getting started', 'Connection, layers, live editing, and firmware updates.', 'Read the guide', `${base}/docs/setup/ferris-sweep-pro/`], ['Open-source firmware', 'Explore the configuration and make your layout your own.', 'View on GitHub', 'https://github.com/nxtkb/Sweep-Pro']],
  contactTitle: 'Product and setup questions', contactCopy: 'WeChat: nxtkb888 · Discord: @lilin0522',
};
const colors = [ ['56', isZh ? '白色' : 'White'], ['67', isZh ? '黑色' : 'Black'], ['57', isZh ? '绿色' : 'Green'], ['58', isZh ? '蓝色' : 'Blue'], ['59', isZh ? '红色' : 'Red'], ['60', isZh ? '橙色' : 'Orange'] ];
---
<ProductLayout title="Ferris Sweep Pro | NXTKB" description={t.description} lang={lang} product={{ name: 'Ferris Sweep Pro', buyHref: '#choose', price: isZh ? `¥${initialHardwarePrice} 起` : `From ¥${initialHardwarePrice}` }}>
  <section class="product-hero" id="overview">
    <div class="product-wrap">
      <h1>{t.headline}</h1>
      <p class="product-intro">{t.intro}</p>
      <p class="product-price">{t.price}</p>
      <div class="product-actions"><a class="product-button" href="#choose">{t.buy}</a><a class="product-link" href={`${base}/docs/setup/ferris-sweep-pro/`}>{t.docs}</a></div>
    </div>
    <div class="product-hero-stage"><div class="product-wrap"><ProductVisual src={`${assets}/56.png`} alt={isZh ? '白色 Ferris Sweep Pro，左侧电子墨水屏、右侧圆形触控板与双旋钮' : 'White Ferris Sweep Pro with left e-ink display, right circular trackpad, and dual encoders'} crop={[0, 390, 2000, 740]} eager /></div></div>
  </section>
  <div class="product-wrap product-facts">{t.facts.map(([value, label]) => <div><strong>{value}</strong><span>{label}</span></div>)}</div>
  <section class="product-section soft" id="details">
    <div class="product-wrap">
      <div class="product-heading"><h2>{t.featureTitle}</h2><p>{t.featureLead}</p></div>
      <div class="product-feature-grid">
        <article class="product-feature"><div class="product-feature-copy"><p class="product-kicker">{t.trackpad[0]}</p><h3>{t.trackpad[1]}</h3><p>{t.trackpad[2]}</p></div><ProductVisual src={`${assets}/56.png`} alt={isZh ? '右半键盘上的 Cirque 触控板与旋钮' : 'Cirque trackpad and encoder on the right half'} crop={[930, 450, 960, 660]} /></article>
        <article class="product-feature"><div class="product-feature-copy"><p class="product-kicker">{t.display[0]}</p><h3>{t.display[1]}</h3><p>{t.display[2]}</p></div><ProductVisual src={`${assets}/56.png`} alt={isZh ? '左半键盘上的电子墨水状态屏与旋钮' : 'E-ink status display and encoder on the left half'} crop={[80, 450, 960, 660]} /></article>
      </div>
      <p class="product-note">{isZh ? '图示配备电子墨水屏与触控板，两项模块均可独立选配。' : 'E-ink display and trackpad shown. Both modules are optional and can be selected independently.'}</p>
    </div>
  </section>
  <section class="product-section"><div class="product-wrap product-story">
    <div><p class="product-kicker">{isZh ? '分层输入' : '34 keys. Your flow.'}</p><h2>{t.keymapTitle}</h2><p>{t.keymapCopy}</p><p class="product-note">{t.keymapNote}</p><a class="product-link" href={`${base}/docs/setup/keymap/ferris-sweep-pro-keymap/`}>{t.keymapLink}</a></div>
    <div class="product-keymap"><img src="/keymaps/ferris-sweep-pro/ferris_sweep_pro_keymap_default_layer.svg" alt={isZh ? 'Ferris Sweep Pro 默认字符层键位图' : 'Ferris Sweep Pro default letter layer'} loading="lazy" width="756" height="405" /></div>
  </div></section>
  <section class="product-section soft"><div class="product-wrap product-story">
    <div class="product-detail-photo"><ProductVisual src={`${assets}/keycaps2.jpeg`} alt={isZh ? '矮轴球帽的外形与表面细节' : 'Low-profile keycap shapes and surface details'} crop={[0, 0, 2378, 1296]} /></div>
    <div><p class="product-kicker">ZMK Studio</p><h2>{t.studioTitle}</h2><p>{t.studioCopy}</p><a class="product-link" href={`${base}/docs/setup/keymap/how-to-update-keymaps/`}>{t.studioLink}</a></div>
  </div></section>
  <section class="product-section"><div class="product-wrap">
    <div class="product-heading"><h2>{t.colorTitle}</h2><p>{t.colorLead}</p></div>
    <div class="product-colors">{colors.map(([image, label]) => <figure class="product-color"><ProductVisual src={`${assets}/${image}.png`} alt={`${label} Ferris Sweep Pro`} crop={[0, 390, 2000, 740]} /><figcaption>{label}</figcaption></figure>)}</div>
    <p class="product-note">{isZh ? '图示配色供参考，可选组合请查看对应配置的商品页。' : 'Colors shown for reference. See the product listing for available combinations.'}</p>
  </div></section>
  <section class="product-section" id="choose"><div class="product-wrap">
    <SweepProConfigurator lang={lang} />
  </div></section>
  <section class="product-section"><div class="product-wrap product-faq"><div class="product-heading"><h2>{t.faqTitle}</h2></div>{t.faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  <section class="product-section soft" id="support"><div class="product-wrap">
    <div class="product-heading"><h2>{t.supportTitle}</h2><p>{t.supportLead}</p></div>
    <div class="product-resources">{t.resources.map(([title, copy, label, href]) => <article class="product-resource"><h3>{title}</h3><p>{copy}</p><a class="product-link" href={href} {...externalLinkAttrs(href)}>{label}</a></article>)}<article class="product-resource"><h3>{t.contactTitle}</h3><p>{t.contactCopy}</p></article></div>
  </div></section>
</ProductLayout>
