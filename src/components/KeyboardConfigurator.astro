---
import ProductVisual from './ProductVisual.astro';
import { sweepProVersions } from '../utils/sweep-pro-config.mjs';
import { customizationGroups, customizationPhotos, customizationPreview, type KeyboardModel } from '../utils/keyboard-customization';
import { externalLinkAttrs } from '../utils/external-links.mjs';
interface Props { lang: 'en' | 'zh'; model: KeyboardModel }
const { lang, model } = Astro.props;
const isZh = lang === 'zh';
const pro = model === 'sweep-pro';
const name = pro ? 'Ferris Sweep Pro' : 'Ferris Sweep';
const initial = pro ? sweepProVersions.find((v) => v.id === 'full')! : { price: 600, url: 'https://item.taobao.com/item.htm?id=818899575086' };
const customGroups = customizationGroups(model, lang);
const photos = customizationPhotos(model);
const initialPreview = customizationPreview(model, customGroups[0].selected);
const hardwareGroups = pro ? (isZh ? [
  { key: 'display', title: '电子墨水屏', question: '状态信息，随时可见。', options: [{ value: 'true', title: '配备电子墨水屏', copy: '1.54 英寸，查看电量、连接和当前层级。', delta: '已选' }, { value: 'false', title: '无需电子墨水屏', copy: '保留简洁的输入体验。', delta: '− ¥100' }] },
  { key: 'trackpad', title: 'Cirque 触控板', question: '把光标控制留在手边。', options: [{ value: 'true', title: '配备 Cirque 触控板', copy: '40mm 圆形触控板，支持移动、点击与滚动。', delta: '已选' }, { value: 'false', title: '无需触控板', copy: '搭配你习惯的外置鼠标。', delta: '− ¥130' }] },
] : [
  { key: 'display', title: 'E-ink display', question: 'Keep your status in view.', options: [{ value: 'true', title: 'With e-ink display', copy: '1.54-inch display for battery, connection, and active layer.', delta: 'Selected' }, { value: 'false', title: 'Without e-ink display', copy: 'Keep the focus on typing.', delta: '− ¥100' }] },
  { key: 'trackpad', title: 'Cirque trackpad', question: 'Keep your cursor close.', options: [{ value: 'true', title: 'With Cirque trackpad', copy: '40mm circular trackpad for movement, clicks, and scrolling.', delta: 'Selected' }, { value: 'false', title: 'Without trackpad', copy: 'Use your preferred external mouse.', delta: '− ¥130' }] },
]) : [];
const initialLabels = customGroups.map((group) => ({ title: group.title, label: group.options.find((option) => option.value === group.selected)!.label }));
---
<keyboard-configurator data-lang={lang} data-model={model} data-product={name}>
  <div class="configurator-grid">
    <div class="configurator-preview"><div class="configurator-preview-inner">
      <p class="product-kicker">{name}</p>
      <div class="configurator-art">{photos.map((photo) => <div data-preview={photo.key} hidden={photo.key !== initialPreview.key}><ProductVisual src={photo.src} alt={isZh ? `${name} 外壳与键帽搭配参考` : `${name} case and keycap appearance reference`} crop={photo.crop} /></div>)}</div>
      <p class="configurator-image-note" data-photo-note>{pro ? (isZh ? '图示配备电子墨水屏与触控板，实际模块以所选配置为准。' : 'Display and trackpad shown. Included modules depend on your selection.') : (isZh ? '图示为所选外壳配色，图片仅作外观参考。' : 'Selected case color shown. Images are for appearance reference.')}</p>
      <div class="configurator-preview-summary" aria-hidden="true"><span data-preview-description>{initialLabels.map((item) => item.label).join(' · ')}</span></div>
      <div class="configurator-common"><span>34 {isZh ? '键分体' : 'split keys'}</span><span>{pro ? (isZh ? '双旋钮' : 'Dual encoders') : 'Choc V1'}</span><span>ZMK Studio</span></div>
    </div></div>
    <div class="configurator-controls">
      <div class="product-heading"><p class="product-kicker">{isZh ? '按你的习惯，逐项选择' : 'Choose what works for you'}</p><h2>{isZh ? `定制你的\n${pro ? 'Sweep Pro' : 'Sweep'}` : `Make ${pro ? 'Sweep Pro' : 'Sweep'}\nyour own`}</h2><p>{isZh ? (pro ? '从硬件到配色与手感，找到自己的搭配。' : '从配色到轴体与支架，找到自己的搭配。') : 'Explore colors, switches, and the details of your setup.'}</p></div>
      <form aria-label={isZh ? `${name} 定制选项` : `${name} customization options`}>
        {hardwareGroups.map((group, index) => <fieldset><legend><span class="configurator-step">{String(index + 1).padStart(2, '0')}</span>{group.title}</legend><p class="configurator-question">{group.question}</p><div class="configurator-options">{group.options.map((option) => <label class="configurator-option"><input type="radio" name={group.key} value={option.value} data-hardware data-label={option.title} checked={option.value === 'true'} disabled /><span class="configurator-option-content"><span class="configurator-option-copy"><strong>{option.title}</strong><span>{option.copy}</span></span><span class="configurator-option-delta" data-delta>{option.delta}</span></span></label>)}</div></fieldset>)}
        {customGroups.map((group, index) => <fieldset data-custom-group={group.key} data-title={group.title}>
          <legend><span class="configurator-step">{String(hardwareGroups.length + index + 1).padStart(2, '0')}</span>{group.title}</legend>
          <p class="configurator-question">{group.hint}</p>
          <div class:list={['customization-options', group.layout]}>{group.options.map((option) => <label class="customization-option">
            <input type="radio" name={group.key} value={option.value} data-label={option.label} checked={option.value === group.selected} disabled />
            <span class="customization-option-content">{option.swatch && <span class="customization-swatch" style={`background:${option.swatch}`} aria-hidden="true"></span>}<span class="customization-option-copy"><strong>{option.label}</strong>{option.copy && <span>{option.copy}</span>}</span><span class="customization-check" aria-hidden="true">✓</span></span>
          </label>)}</div>
        </fieldset>)}
      </form>
      <div class="configurator-checkout">
        <div class="configurator-total" aria-live="polite" aria-atomic="true"><p>{isZh ? '你的配置' : 'Your configuration'}</p><p class="configurator-total-price"><span data-price>¥{initial.price}</span><span>{isZh ? '键盘起价' : 'keyboard starting price'}</span></p><p class="configurator-price-note">{isZh ? '轴体、配色与支架套餐的实际价格，以商品页为准。' : 'Final prices for switches, colors, and stand bundles are shown on the product listing.'}</p><p class="configurator-module-summary" data-modules hidden={!pro}>{isZh ? '配备电子墨水屏 · 配备 Cirque 触控板' : 'With e-ink display · With Cirque trackpad'}</p></div>
        <dl class="configurator-selection-list">{initialLabels.map((item, index) => <div><dt>{item.title}</dt><dd data-selected={customGroups[index].key}>{item.label}</dd></div>)}</dl>
        {pro && <dl class="configurator-breakdown"><div><dt>{isZh ? '基础键盘' : 'Base keyboard'}</dt><dd>¥620</dd></div><div><dt>{isZh ? '电子墨水屏' : 'E-ink display'}</dt><dd data-display-price>+ ¥100</dd></div><div><dt>{isZh ? 'Cirque 触控板' : 'Cirque trackpad'}</dt><dd data-trackpad-price>+ ¥130</dd></div></dl>}
        <div class="configurator-copy-row"><button type="button" data-copy disabled>{isZh ? '复制我的配置' : 'Copy my configuration'}</button><span data-copy-status role="status"></span></div>
        <textarea data-copy-fallback hidden readonly aria-label={isZh ? '可手动复制的配置清单' : 'Configuration to copy manually'}></textarea>
        <a class="product-button configurator-buy" data-buy href={initial.url} {...externalLinkAttrs(initial.url)}>{isZh ? '前往淘宝确认并选购' : 'Confirm and buy on Taobao'}<span aria-hidden="true">↗</span></a>
        <p class="product-note">{isZh ? '请在淘宝重新选择对应的配色、轴体与套餐，也可复制配置发给客服确认可选搭配。' : 'Select the matching colors, switches, and bundle on Taobao, or share your copied configuration with the seller to confirm availability.'}</p>
      </div>
      <noscript><p class="product-note">{isZh ? '开启 JavaScript 可预览搭配，也可直接前往淘宝选择。' : 'Enable JavaScript to preview combinations, or choose directly on Taobao.'}</p>{pro && <div class="configurator-fallback">{sweepProVersions.map((v) => <a href={v.url} {...externalLinkAttrs(v.url)}>{v.display ? (isZh ? '配备电子墨水屏' : 'With e-ink display') : (isZh ? '无电子墨水屏' : 'Without e-ink display')} · {v.trackpad ? (isZh ? '配备触控板' : 'With trackpad') : (isZh ? '无触控板' : 'Without trackpad')} · ¥{v.price}</a>)}</div>}</noscript>
    </div>
  </div>
</keyboard-configurator>

<script>
  import { sweepProConfiguration } from '../utils/sweep-pro-config.mjs';
  import { customizationPreview, type KeyboardModel } from '../utils/keyboard-customization';
  class KeyboardConfigurator extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const isZh = this.dataset.lang === 'zh';
      const model = this.dataset.model as KeyboardModel;
      const pro = model === 'sweep-pro';
      const form = this.querySelector('form')!;
      const text = (selector: string, value: string) => { this.querySelector(selector)!.textContent = value; };
      let configurationText = '';
      const update = () => {
        const selection = new FormData(form);
        const display = selection.get('display') === 'true';
        const trackpad = selection.get('trackpad') === 'true';
        const hardware = pro ? sweepProConfiguration(display, trackpad)! : { price: 600, url: 'https://item.taobao.com/item.htm?id=818899575086' };
        text('[data-price]', `¥${hardware.price}`);
        const headerPrice = isZh ? `¥${hardware.price} 起` : `From ¥${hardware.price}`;
        this.closest('.site-shell')?.querySelectorAll<HTMLElement>('[data-header-price]').forEach((price) => {
          price.textContent = headerPrice;
        });
        const modules = pro ? [display ? (isZh ? '配备电子墨水屏' : 'With e-ink display') : (isZh ? '无电子墨水屏' : 'Without e-ink display'), trackpad ? (isZh ? '配备 Cirque 触控板' : 'With Cirque trackpad') : (isZh ? '无触控板' : 'Without trackpad')].join(' · ') : '';
        text('[data-modules]', modules);
        if (pro) {
          text('[data-display-price]', display ? '+ ¥100' : (isZh ? '未选配' : 'Not included'));
          text('[data-trackpad-price]', trackpad ? '+ ¥130' : (isZh ? '未选配' : 'Not included'));
          for (const input of form.querySelectorAll<HTMLInputElement>('input[data-hardware]')) {
            const alternate = sweepProConfiguration(input.name === 'display' ? input.value === 'true' : display, input.name === 'trackpad' ? input.value === 'true' : trackpad)!;
            const difference = alternate.price - hardware.price;
            input.closest('label')!.querySelector('[data-delta]')!.textContent = input.checked ? (isZh ? '已选' : 'Selected') : `${difference > 0 ? '+' : '−'} ¥${Math.abs(difference)}`;
          }
        }
        const selections: string[] = [];
        const labels: string[] = [];
        for (const group of form.querySelectorAll<HTMLElement>('[data-custom-group]')) {
          const selected = group.querySelector<HTMLInputElement>('input:checked')!;
          text(`[data-selected="${group.dataset.customGroup}"]`, selected.dataset.label!);
          selections.push(`${group.dataset.title}: ${selected.dataset.label}`);
          labels.push(selected.dataset.label!);
        }
        text('[data-preview-description]', labels.join(' · '));
        const preview = customizationPreview(model, String(selection.get('color')), String(selection.get('keycaps') ?? 'white'));
        this.querySelectorAll<HTMLElement>('[data-preview]').forEach((photo) => { photo.hidden = photo.dataset.preview !== preview.key; });
        text('[data-photo-note]', preview.exact
          ? (pro ? (isZh ? '图示为所选外壳与键帽配色。屏幕与触控板以所选配置为准。' : 'Selected case and keycap colors shown. Display and trackpad depend on your selection.') : (isZh ? '图示为所选外壳配色，图片仅作外观参考。' : 'Selected case color shown. Images are for appearance reference.'))
          : (isZh ? '该配色请咨询确认，图示为其他配色的外观参考。' : 'Confirm this color with the seller. Another color is shown for appearance reference.'));
        const buy = this.querySelector<HTMLAnchorElement>('[data-buy]')!;
        buy.href = hardware.url;
        buy.setAttribute('aria-label', isZh ? `在淘宝确认并选购 ${this.dataset.product}，${[modules, ...labels].filter(Boolean).join('，')}` : `Confirm and buy ${this.dataset.product} on Taobao, ${[modules, ...labels].filter(Boolean).join(', ')}`);
        configurationText = [this.dataset.product!, ...(modules ? [modules] : []), ...selections, `${isZh ? '键盘参考起价' : 'Keyboard starting price'}: ¥${hardware.price}`, isZh ? '实际价格及可选搭配请确认' : 'Please confirm final pricing and availability'].join('\n');
        text('[data-copy-status]', '');
        this.querySelector<HTMLTextAreaElement>('[data-copy-fallback]')!.hidden = true;
      };
      form.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.disabled = false; });
      form.addEventListener('change', update);
      form.addEventListener('submit', (event) => event.preventDefault());
      const copy = this.querySelector<HTMLButtonElement>('[data-copy]')!;
      copy.disabled = false;
      copy.addEventListener('click', async () => {
        const snapshot = configurationText;
        try {
          await navigator.clipboard.writeText(snapshot);
          if (snapshot === configurationText) text('[data-copy-status]', isZh ? '已复制' : 'Copied');
        } catch {
          const fallback = this.querySelector<HTMLTextAreaElement>('[data-copy-fallback]')!;
          fallback.value = configurationText;
          fallback.hidden = false;
          fallback.focus();
          fallback.select();
          text('[data-copy-status]', isZh ? '请选择文字手动复制' : 'Select the text to copy manually');
        }
      });
      update();
    }
  }
  if (!customElements.get('keyboard-configurator')) customElements.define('keyboard-configurator', KeyboardConfigurator);
</script>
<style>
  keyboard-configurator { display: block; }
  .configurator-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(3rem, 6vw, 6rem); align-items: start; }
  .configurator-preview { position: sticky; top: 6rem; }
  .configurator-preview-inner { padding-top: 1.5rem; }
  .configurator-preview .product-kicker { color: var(--product-ink); font-size: 1.3rem; font-weight: 650; letter-spacing: -.03em; }
  .configurator-art { overflow: hidden; border-radius: 24px; background: #e6e6e6; padding: 3.8rem 0; }
  .configurator-image-note { margin: 1rem 0 0; color: var(--product-muted); font-size: .75rem; line-height: 1.7; text-align: center; }
  .configurator-preview-summary { display: grid; gap: .5rem; text-align: center; margin-top: 2rem; }
  .configurator-preview-summary span { color: var(--product-muted); font-size: .85rem; line-height: 1.6; }
  .configurator-common { display: flex; flex-wrap: wrap; justify-content: center; gap: .7rem 1.2rem; margin-top: 1.8rem; padding-top: 1.5rem; border-top: 1px solid #dedee2; color: var(--product-muted); font-size: .8rem; }
  .configurator-controls { min-width: 0; }
  .configurator-controls .product-heading { margin-bottom: 2.5rem; }
  .configurator-controls h2 { white-space: pre-line; font-size: clamp(2.1rem, 3.6vw, 3.2rem); }
  .configurator-controls .product-heading p:last-child { font-size: .95rem; }
  fieldset { min-width: 0; padding: 0; border: 0; margin: 0 0 2.7rem; }
  legend { padding: 0; font-size: 1.2rem; font-weight: 650; letter-spacing: -.025em; }
  .configurator-step { margin-right: .8rem; font-size: .8rem; color: var(--product-accent); vertical-align: middle; }
  .configurator-question { margin: .7rem 0 1.2rem; color: var(--product-muted); font-size: .9rem; line-height: 1.7; }
  .configurator-options { display: grid; gap: .8rem; }
  .configurator-option { position: relative; display: block; cursor: pointer; }
  .configurator-option input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .configurator-option-content { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 6rem; padding: 1.2rem; border: 1px solid #bcbcc1; border-radius: 14px; background: #fff; }
  .configurator-option-copy { display: grid; gap: .45rem; }
  .configurator-option-copy strong { font-size: .95rem; font-weight: 600; line-height: 1.5; }
  .configurator-option-copy > span { color: var(--product-muted); font-size: .78rem; line-height: 1.7; }
  .configurator-option-delta { flex-shrink: 0; font-size: .85rem; font-variant-numeric: tabular-nums; }
  .configurator-option:hover .configurator-option-content { border-color: var(--product-accent); }
  .configurator-option input:checked + .configurator-option-content { border-color: var(--product-accent); box-shadow: inset 0 0 0 1px var(--product-accent); background: #f2f8f7; }
  .configurator-option input:checked + .configurator-option-content .configurator-option-delta { color: var(--product-accent); font-weight: 650; }
  .configurator-option input:focus-visible + .configurator-option-content { outline: 3px solid var(--product-accent); outline-offset: 4px; }
  .configurator-checkout { border-top: 1px solid #d8d8dc; padding-top: 1.8rem; }
  .configurator-total > p:first-child { font-size: .9rem; font-weight: 600; margin: 0 0 .8rem; }
  .configurator-total-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: .5rem; margin: 0; }
  .configurator-total-price span:first-child { font-size: 2.8rem; font-weight: 650; letter-spacing: -.055em; font-variant-numeric: tabular-nums; }
  .configurator-total-price span:last-child { font-size: .85rem; color: var(--product-muted); }
  .configurator-module-summary { margin: .6rem 0 0; font-size: .8rem; color: var(--product-muted); line-height: 1.8; }
  .configurator-breakdown { display: grid; gap: .7rem; margin: 1.5rem 0 1.8rem; font-size: .85rem; }
  .configurator-breakdown > div { display: flex; justify-content: space-between; gap: 1rem; }
  .configurator-breakdown dt { color: var(--product-muted); }
  .configurator-breakdown dd { margin: 0; }
  .product-button.configurator-buy { width: 100%; gap: .8rem; min-height: 3.3rem; font-size: .95rem; }
  .configurator-checkout .product-note { margin-top: 1rem; }
  .configurator-fallback { margin-top: 1.5rem; line-height: 1.8; }
  .configurator-fallback a { display: block; padding-block: .5rem; color: var(--product-accent); }
  @media (max-width: 900px) {
    .configurator-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; }
    .configurator-art { padding-block: 2rem; }
    .configurator-option-content { padding: 1rem; }
  }
  @media (max-width: 760px) {
    .configurator-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .configurator-preview { position: static; }
    .configurator-preview-inner { padding-top: 0; }
    .configurator-art { padding-block: 1rem; }
    .configurator-preview .product-kicker, .configurator-common, .configurator-preview-summary { display: none; }
    .configurator-controls h2 { white-space: normal; }
    .configurator-controls .product-heading { margin-bottom: 2rem; }
    .configurator-option-content { min-height: 5.5rem; padding: 1.1rem; }
  }
  @media (min-width: 761px) and (max-height: 700px) { .configurator-preview { top: 5rem; } .configurator-art { padding-block: 1rem; } }
  .configurator-art [hidden] { display: none; }
  .configurator-price-note { color: var(--product-muted); font-size: .8rem; line-height: 1.8; margin: .7rem 0 1rem; }
  .configurator-selection-list { display: grid; gap: .8rem; margin: 1.6rem 0; font-size: .85rem; }
  .configurator-selection-list > div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: .8rem; line-height: 1.7; }
  .configurator-selection-list dt { color: var(--product-muted); }
  .configurator-selection-list dd { margin: 0; text-align: right; overflow-wrap: anywhere; }
  .customization-options { display: grid; gap: .65rem; }
  .customization-options.swatches { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .customization-options.chips { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .customization-option { position: relative; cursor: pointer; min-width: 0; }
  .customization-option input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .customization-option-content { position: relative; display: flex; height: 100%; align-items: center; justify-content: space-between; gap: .5rem; min-height: 3.6rem; padding: .9rem; border: 1px solid #bcbcc1; border-radius: 12px; background: #fff; }
  .customization-option:hover .customization-option-content { border-color: var(--product-accent); }
  .customization-option input:checked + .customization-option-content { border-color: var(--product-accent); box-shadow: inset 0 0 0 1px var(--product-accent); background: #f2f8f7; }
  .customization-option input:focus-visible + .customization-option-content { outline: 3px solid var(--product-accent); outline-offset: 4px; }
  .customization-check { opacity: 0; color: var(--product-accent); font-weight: 650; font-size: .85rem; }
  .customization-option input:checked + .customization-option-content .customization-check { opacity: 1; }
  .customization-swatch { width: 1.8rem; height: 1.8rem; border-radius: 50%; border: 1px solid rgb(0 0 0 / 15%); box-shadow: inset 0 0 0 2px rgb(255 255 255 / 40%); }
  .swatches .customization-option-content { flex-direction: column; padding: 1rem .4rem .75rem; justify-content: center; text-align: center; gap: .6rem; }
  .swatches .customization-check { position: absolute; top: .25rem; right: .35rem; }
  .customization-option-copy { display: grid; gap: .4rem; }
  .customization-option-copy strong { font-size: .83rem; font-weight: 550; line-height: 1.5; }
  .customization-option-copy > span { color: var(--product-muted); font-size: .78rem; line-height: 1.7; }
  .cards .customization-option-content { padding: 1.2rem; }
  .cards .customization-option-copy strong { font-size: .95rem; }
  .configurator-copy-row { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin: 1.5rem 0 1rem; }
  .configurator-copy-row button { padding: .55rem 1rem; border: 1px solid #bcbcc1; border-radius: 99px; background: #fff; color: var(--product-accent); font: inherit; font-size: .85rem; cursor: pointer; }
  .configurator-copy-row button:hover { border-color: var(--product-accent); }
  .configurator-copy-row [role="status"] { font-size: .8rem; color: var(--product-muted); }
  textarea[data-copy-fallback] { width: 100%; min-height: 13rem; padding: 1rem; margin-bottom: 1rem; border: 1px solid #bcbcc1; border-radius: 12px; background: #fff; color: var(--product-ink); font: inherit; font-size: .85rem; line-height: 1.8; }
  @media (min-width: 761px) and (max-width: 1000px) { .customization-options.swatches { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
