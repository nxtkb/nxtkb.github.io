---
import ProductDetailPage from './ProductDetailPage.astro';
interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const copy = isZh ? {
  "name": "Ferris Sweep",
  "description": "34 键矮轴无线分体键盘，支持热插拔和 ZMK Studio 实时改键。",
  "headline": "轻装上桌\n自在输入",
  "intro": "34 键，左右分体。矮轴、蓝牙与热插拔设计，为日常输入留下更多桌面空间。",
  "price": "¥600 起",
  "facts": [
    [
      "34 键",
      "分体式布局"
    ],
    [
      "Choc V1",
      "凯华矮轴"
    ],
    [
      "热插拔",
      "按喜好更换轴体"
    ],
    [
      "ZMK Studio",
      "实时改键"
    ]
  ],
  "detailTitle": "从手感到配色，\n按你的喜好。",
  "detailLead": "选择喜欢的矮轴与外壳配色，再通过 ZMK Studio 调整键位。也可搭配磁吸支架，设置左右手的摆放角度。",
  "details": [
    [
      "布局",
      "34 键 Ferris Sweep 分体布局"
    ],
    [
      "轴体",
      "凯华 Choc V1 矮轴，多种轴体可选"
    ],
    [
      "配色",
      "单色、双色与自定义配色，具体选项见商品页"
    ],
    [
      "套餐",
      "键盘 / 键盘与磁吸支架"
    ],
    [
      "兼容平台",
      "Linux、Windows、Android、HarmonyOS、macOS、iOS"
    ]
  ]
} : {
  "name": "Ferris Sweep",
  "description": "A 34-key low-profile wireless split keyboard with hot-swap switches and ZMK Studio.",
  "headline": "Less on your desk\nMore room to work",
  "intro": "34 keys, two halves. Low-profile switches, Bluetooth, and a hot-swap design make room for your everyday work.",
  "price": "From ¥600",
  "facts": [
    [
      "34 keys",
      "Split layout"
    ],
    [
      "Choc V1",
      "Kailh low-profile switches"
    ],
    [
      "Hot-swap",
      "Choose your feel"
    ],
    [
      "ZMK Studio",
      "Live keymap editing"
    ]
  ],
  "detailTitle": "Your feel.\nYour finish.",
  "detailLead": "Choose switches and a case color, then make the keymap your own with ZMK Studio. Add magnetic stands to set each half at your preferred angle.",
  "details": [
    [
      "Layout",
      "34-key Ferris Sweep split layout"
    ],
    [
      "Switches",
      "Kailh Choc V1, with multiple switch options"
    ],
    [
      "Colors",
      "Solid, two-tone, and custom options; see the product listing"
    ],
    [
      "Kits",
      "Keyboard / keyboard with magnetic stands"
    ],
    [
      "Platforms",
      "Linux, Windows, Android, HarmonyOS, macOS, iOS"
    ]
  ]
};
const photo = {
  "src": "/products/ferris-sweep/sweep-1.png",
  "alt": isZh ? 'Ferris Sweep 分体键盘' : 'Ferris Sweep split keyboard'
};
const secondaryPhoto = {
  "src": "/products/ferris-sweep/sweep-2.png",
  "alt": isZh ? 'Ferris Sweep 分体键盘' : 'Ferris Sweep split keyboard'
};
---
<ProductDetailPage lang={lang} copy={copy} buyHref="https://item.taobao.com/item.htm?id=818899575086"
  photo={{...photo, crop: [
  0,
  790,
  1728,
  850
]}}
  secondaryPhoto={{...secondaryPhoto, crop: [
  0,
  790,
  1728,
  850
]}}
  configurator="sweep"
  docsPath="/docs/setup/ferris-sweep/"
  keymapPath="/keymaps/ferris-sweep/ferris_sweep_keymap_default_layer.svg"
/>
