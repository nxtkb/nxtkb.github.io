---
import ProductDetailPage from './ProductDetailPage.astro';
interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const copy = isZh ? {
  "name": "NXTKB 矮轴键帽",
  "description": "34 键 PBT 矮轴键帽，五面热升华，正刻与侧刻副层级标识，提供黑白两色。",
  "headline": "指尖触感\n细节入微",
  "intro": "34 键 PBT 矮轴键帽，以五面热升华呈现字符与层级标识。黑与白，为你的 Sweep Pro 选择一种表达。",
  "price": "¥70 / 套",
  "facts": [
    [
      "34 键",
      "紧凑布局套装"
    ],
    [
      "PBT",
      "颗粒表面质感"
    ],
    [
      "热升华",
      "五面字符工艺"
    ],
    [
      "黑 / 白",
      "两种颜色"
    ]
  ],
  "detailTitle": "每一层，\n都有迹可循。",
  "detailLead": "正面字符清晰，侧面标识辅助记忆副层级。矮轴球帽外形与 PBT 表面，让每一次输入都落在细节上。",
  "details": [
    [
      "套装",
      "34 键"
    ],
    [
      "材质",
      "PBT"
    ],
    [
      "工艺",
      "五面热升华，含副层级侧刻"
    ],
    [
      "颜色",
      "白色 / 黑色"
    ],
    [
      "适配",
      "适用于 Sweep Pro；其他键盘请先确认轴体接口与键位尺寸。图示键盘不包含在键帽套装内。"
    ]
  ]
} : {
  "name": "NXTKB Low-profile Keycaps",
  "description": "34-key PBT low-profile keycaps with five-sided dye sublimation and side legends, in black or white.",
  "headline": "Small details\nA feel of your own",
  "intro": "A 34-key PBT set with five-sided dye sublimation for characters and layer markings. Choose black or white for your Sweep Pro.",
  "price": "¥70 / set",
  "facts": [
    [
      "34 keys",
      "Compact layout kit"
    ],
    [
      "PBT",
      "Textured surface"
    ],
    [
      "Dye-sub",
      "Five-sided legends"
    ],
    [
      "Black / white",
      "Two finishes"
    ]
  ],
  "detailTitle": "A guide to\nevery layer.",
  "detailLead": "Clear top legends meet side markings that help you remember your layers. Low-profile sculpted keycaps and a textured PBT surface bring detail to every press.",
  "details": [
    [
      "Kit",
      "34 keys"
    ],
    [
      "Material",
      "PBT"
    ],
    [
      "Process",
      "Five-sided dye sublimation, with layer side legends"
    ],
    [
      "Colors",
      "White / black"
    ],
    [
      "Compatibility",
      "For Sweep Pro. Confirm switch stems and key sizes for other keyboards. Keyboard shown is sold separately."
    ]
  ]
};
const photo = {
  "src": "/products/low-profile-keycaps/white.png",
  "alt": isZh ? 'NXTKB 矮轴键帽装在键盘上的效果' : 'NXTKB low-profile keycaps shown on a keyboard'
};
const secondaryPhoto = {
  "src": "/products/low-profile-keycaps/black.png",
  "alt": isZh ? 'NXTKB 矮轴键帽装在键盘上的效果' : 'NXTKB low-profile keycaps shown on a keyboard'
};
---
<ProductDetailPage lang={lang} copy={copy} buyHref="https://item.taobao.com/item.htm?id=1028293273125"
  photo={{...photo, crop: [
  0,
  500,
  2000,
  1500
]}}
  secondaryPhoto={{...secondaryPhoto, crop: [
  0,
  500,
  2000,
  1500
]}}
  legendImage="/products/low-profile-keycaps/keymap.png"
/>
