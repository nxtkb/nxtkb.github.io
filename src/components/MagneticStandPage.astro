---
import ProductDetailPage from './ProductDetailPage.astro';
interface Props { lang?: 'en' | 'zh' }
const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';
const copy = isZh ? {
  "name": "磁吸支架",
  "description": "用于 Ferris Sweep 分体键盘的黑色金属磁吸万向支架，一对装。",
  "headline": "找到你的\n舒适角度",
  "intro": "左右分体，各自调整。金属磁吸万向支架，让键盘按你的习惯摆放。",
  "price": "¥60 / 对",
  "facts": [
    [
      "一对装",
      "左右手分别支撑"
    ],
    [
      "万向调节",
      "按需设置角度"
    ],
    [
      "磁吸连接",
      "便于取放键盘"
    ],
    [
      "金属材质",
      "夹持式固定"
    ]
  ],
  "detailTitle": "抬起键盘，\n调整姿态。",
  "detailLead": "通过万向关节调整位置和倾角，以夹持式底座固定在桌面。适合为分体键盘探索不同的摆放方式。",
  "details": [
    [
      "套装",
      "黑色支架一对"
    ],
    [
      "材质",
      "金属"
    ],
    [
      "固定方式",
      "夹持式底座、磁吸连接"
    ],
    [
      "长度",
      "10cm"
    ],
    [
      "搭配建议",
      "购买前确认键盘磁吸安装方式与桌面夹持条件；图示键盘不包含在支架内"
    ]
  ]
} : {
  "name": "Magnetic Stand",
  "description": "A pair of black metal magnetic ball-joint stands for Ferris Sweep split keyboards.",
  "headline": "Find your\ncomfortable angle",
  "intro": "Two halves, individually positioned. Magnetic metal ball-joint stands let you place your keyboard your way.",
  "price": "¥60 / pair",
  "facts": [
    [
      "One pair",
      "Support for both halves"
    ],
    [
      "Adjustable",
      "Set your preferred angle"
    ],
    [
      "Magnetic",
      "Easy keyboard placement"
    ],
    [
      "Metal",
      "Clamp-mounted base"
    ]
  ],
  "detailTitle": "Raise your keyboard.\nAdjust your setup.",
  "detailLead": "Use the ball joint to adjust position and tilt, and the clamp base to secure it to your desk. Explore a new way to position your split keyboard.",
  "details": [
    [
      "Kit",
      "One pair of black stands"
    ],
    [
      "Material",
      "Metal"
    ],
    [
      "Mount",
      "Clamp base with magnetic attachment"
    ],
    [
      "Length",
      "10cm"
    ],
    [
      "Compatibility",
      "Confirm the keyboard attachment and desk clamp fit before buying. Keyboard shown is sold separately."
    ]
  ]
};
const photo = {
  "src": "/products/magnetic-stand/stand-2.png",
  "alt": isZh ? '磁吸支架与键盘搭配展示' : 'Magnetic stand shown with a keyboard'
};
const secondaryPhoto = {
  "src": "/products/magnetic-stand/stand-2.png",
  "alt": isZh ? '磁吸支架与键盘搭配展示' : 'Magnetic stand shown with a keyboard'
};
---
<ProductDetailPage lang={lang} copy={copy} buyHref="https://item.taobao.com/item.htm?id=964509272744"
  photo={{...photo, crop: [
  0,
  260,
  2000,
  1240
]}}
  secondaryPhoto={{...secondaryPhoto, crop: [
  0,
  260,
  1550,
  1240
]}}
/>
